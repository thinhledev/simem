{
  "memory": {
    "enabled": true,
    "storage": "global",
    "syncDir": "",
    "verbatimCheckpoints": 8,
    "epochSize": 10,
    "projectDigestEpochs": 5,
    "consolidationTokenCapChars": 16000,
    "consolidationTimeoutMs": 30000,
    "queueDrainLimit": 3,
    "consolidationExistingItemsLimit": 80,
    "rollupSummaryCharCap": 1200,
    "budget": {
      "totalChars": 12000,
      "verbatimChars": 6000,
      "semanticChars": 2000,
      "retrievedChars": 2000,
      "digestChars": 2000
    },
    "scoring": {
      "recencyWeight": 0.2,
      "importanceWeight": 0.3,
      "relevanceWeight": 0.5,
      "halfLifeDays": 30
    },
    "embeddings": {
      "enabled": true,
      "provider": "builtin",
      "builtinModel": "potion-base-8M",
      "ollamaUrl": "http://localhost:11434",
      "model": "nomic-embed-text",
      "minSimilarity": 0,
      "strongSimilarity": 0
    },
    "hooks": {
      "perPromptInjection": true,
      "perPromptMaxChars": 600,
      "sessionStartBrief": true,
      "briefMaxChars": 4000,
      "taskCompletionSavings": true
    },
    "distill": {
      "remote": false,
      "ollamaModel": ""
    }
  },
  "compression": {
    "bashRewrite": "auto",
    "readGuard": "suggest",
    "rereadGuard": "suggest",
    "largeReadLines": 800,
    "rtk": "defer"
  },
  "mcp": {
    "toolGroups": [
      "memory",
      "code",
      "compression",
      "setup",
      "handoff"
    ]
  }
}
