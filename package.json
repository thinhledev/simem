{
  "name": "simem",
  "version": "2.0.0",
  "description": "simem — Super Intelligence Memory for AI coding agents: spend fewer tokens in the Claude Code and Codex apps, and keep project memory across every account, agent, and worktree.",
  "type": "module",
  "license": "MIT",
  "author": "Thinh Le",
  "homepage": "https://github.com/thinhledev/simem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinhledev/simem.git"
  },
  "bugs": {
    "url": "https://github.com/thinhledev/simem/issues"
  },
  "keywords": [
    "super-intelligence-memory",
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "memory",
    "persistent-memory",
    "project-memory",
    "token-savings",
    "context-compression",
    "context-window",
    "mcp",
    "local-first",
    "embeddings",
    "code-search",
    "developer-tools",
    "llm"
  ],
  "bin": {
    "simem": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --import ./test/setup.ts --test test/*.test.ts",
    "prepublishOnly": "npm run build && node scripts/check-dist.mjs && npm test",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "build:clean": "rm -rf dist && npm run build"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
